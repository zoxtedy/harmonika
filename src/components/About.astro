---
import { config } from '../config';
import { dictionaries, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dictionaries[lang].about;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const photo = config.teacherPhoto ? `${base}${config.teacherPhoto.replace(/^\//, '')}` : '';
const name = config.teacherName[lang];
const initials = name
  .split(/\s+/)
  .map((part) => part[0])
  .join('')
  .slice(0, 2);
const stats = (['years', 'students', 'ages'] as const)
  .map((key) => ({ value: config.stats[key], label: t.stats[key] }))
  .filter((s) => s.value);
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="container about">
    <figure class="about__portrait" data-reveal>
      <div class="about__frame">
        {
          photo ? (
            <img src={photo} alt={t.photoAlt} width="560" height="700" loading="lazy" decoding="async" />
          ) : (
            <div class="about__monogram" role="img" aria-label={t.photoAlt}>
              <span>{initials}</span>
            </div>
          )
        }
      </div>
      <figcaption>{name}</figcaption>
    </figure>

    <div class="about__body" data-reveal>
      <p class="kicker"><span class="kicker__num">I</span>{t.kicker}</p>
      <h2 id="about-title" class="section-title">{t.title}</h2>
      <div class="about__text">
        {t.paragraphs.map((p) => <p>{p.replace('{cityIn}', config.cityIn[lang])}</p>)}
      </div>
      {
        stats.length > 0 && (
          <dl class="about__stats">
            {stats.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 7vw, 6rem);
  }

  .about__portrait {
    margin: 0;
  }

  .about__frame {
    position: relative;
  }

  .about__frame::before {
    content: '';
    position: absolute;
    inset: 1.25rem -1.25rem -1.25rem 1.25rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
  }

  .about__portrait img,
  .about__monogram {
    position: relative;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .about__monogram {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 30% 20%, rgb(201 164 106 / 0.16), transparent 60%),
      repeating-linear-gradient(90deg, rgb(201 164 106 / 0.05) 0 1px, transparent 1px 22px),
      var(--bg-card);
  }

  .about__monogram span {
    font-family: var(--font-display);
    font-size: clamp(5rem, 14vw, 9rem);
    font-style: italic;
    color: var(--brass);
    opacity: 0.85;
  }

  .about__portrait figcaption {
    position: relative;
    margin-top: 2.25rem;
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-style: italic;
  }

  .about__text {
    display: grid;
    gap: 1.15rem;
    margin-top: 1.75rem;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .about__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin: 2.75rem 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .about__stats div {
    display: flex;
    flex-direction: column-reverse;
  }

  .about__stats dd {
    margin: 0;
    color: var(--brass);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    line-height: 1.1;
  }

  .about__stats dt {
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.4;
  }

  @media (max-width: 52rem) {
    .about {
      grid-template-columns: 1fr;
    }

    .about__portrait {
      max-width: 22rem;
    }

    .about__frame::before {
      inset: 0.75rem -0.75rem -0.75rem 0.75rem;
    }
  }

  @media (max-width: 26rem) {
    .about__stats {
      gap: 1rem;
    }

    .about__stats dt {
      font-size: 0.65rem;
      letter-spacing: 0.08em;
    }
  }
</style>
