---
import Icon from './Icon.astro';
import { config } from '../config';
import { dictionaries, type Lang } from '../i18n';
import { links } from '../lib/contact';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dictionaries[lang].hero;

// Illustration geometry: a piano accordion seen from the front —
// treble keyboard on the left, pleated bellows, bass buttons on the right.
const keyCount = 15;
const keyH = 17;
const blackPattern = [1, 1, 0, 1, 1, 1, 0]; // black key after each white key within an octave
const pleats = Array.from({ length: 13 }, (_, i) => i);
const bassRows = Array.from({ length: 12 }, (_, r) => r);
const bassCols = Array.from({ length: 4 }, (_, c) => c);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="hero__eyebrow">
        {
          t.tagline.map((word, i) => (
            <span class="hero__word">
              {i > 0 && (
                <span class="hero__dot" aria-hidden="true">
                  ·
                </span>
              )}
              {word}
            </span>
          ))
        }
      </p>
      <h1 id="hero-title" class="hero__title">
        {dictionaries[lang].school} <em>{config.teacherName[lang]}</em>
      </h1>
      <p class="hero__lead">{t.lead}</p>
      <div class="hero__actions">
        <a class="btn btn--solid" href={links.whatsapp(lang)} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          {t.primary}
        </a>
        <a class="btn btn--ghost" href="#lessons">
          {t.secondary}
        </a>
      </div>
    </div>

    <div class="hero__art" aria-hidden="true">
      <svg viewBox="0 0 400 330" class="accordion">
        <defs>
          <linearGradient id="pleat-a" x1="0" x2="1">
            <stop offset="0" stop-color="#2a221a"></stop>
            <stop offset="1" stop-color="#4a3826"></stop>
          </linearGradient>
          <linearGradient id="pleat-b" x1="0" x2="1">
            <stop offset="0" stop-color="#6b5235"></stop>
            <stop offset="1" stop-color="#2a221a"></stop>
          </linearGradient>
          <linearGradient id="body" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#211b15"></stop>
            <stop offset="1" stop-color="#14110d"></stop>
          </linearGradient>
        </defs>

        <!-- Treble side with vertical keyboard -->
        <rect x="8" y="12" width="96" height="306" rx="10" fill="url(#body)" stroke="#c9a46a" stroke-opacity=".35"
        ></rect>
        <g transform="translate(46 32)">
          {
            Array.from({ length: keyCount }, (_, i) => (
              <rect x="0" y={i * keyH} width="46" height={keyH - 1.5} rx="1.5" fill="#ece4d6" />
            ))
          }
          {
            Array.from({ length: keyCount - 1 }, (_, i) =>
              blackPattern[i % 7] ? (
                <rect x="0" y={(i + 1) * keyH - 5.5} width="27" height="9.5" rx="1" fill="#0e0c0a" />
              ) : null,
            )
          }
        </g>
        <line x1="30" y1="30" x2="30" y2="300" stroke="#c9a46a" stroke-opacity=".5"></line>

        <!-- Bellows -->
        <g class="accordion__bellows">
          {
            pleats.map((i) => (
              <rect
                x={112 + i * 13}
                y="24"
                width="13"
                height="282"
                fill={i % 2 ? 'url(#pleat-b)' : 'url(#pleat-a)'}
              />
            ))
          }
          <rect x="112" y="24" width="169" height="282" fill="none" stroke="#c9a46a" stroke-opacity=".3"></rect>
          {
            pleats.map((i) => (
              <>
                <path
                  d={`M${112 + i * 13} 24 h13 v9 h-13z`}
                  fill="#c9a46a"
                  fill-opacity={i % 2 ? 0.75 : 0.5}
                />
                <path
                  d={`M${112 + i * 13} 297 h13 v9 h-13z`}
                  fill="#c9a46a"
                  fill-opacity={i % 2 ? 0.75 : 0.5}
                />
              </>
            ))
          }
        </g>

        <!-- Bass side with buttons -->
        <rect x="289" y="12" width="103" height="306" rx="10" fill="url(#body)" stroke="#c9a46a" stroke-opacity=".35"
        ></rect>
        <g transform="translate(310 46)">
          {
            bassRows.map((r) =>
              bassCols.map((c) => (
                <circle
                  cx={c * 17 + (r % 2) * 6}
                  cy={r * 21}
                  r="5.2"
                  fill={c === 1 && r % 3 === 0 ? '#e3c590' : '#c9a46a'}
                  fill-opacity={c === 1 && r % 3 === 0 ? 1 : 0.62}
                />
              )),
            )
          }
        </g>
      </svg>
      <div class="hero__frame"></div>
    </div>
  </div>

  <a class="hero__scroll" href="#about" aria-label={dictionaries[lang].nav.about}>
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + 3rem) 5rem;
    overflow: hidden;
  }

  .hero__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60rem 40rem at 78% 40%, rgb(201 164 106 / 0.11), transparent 60%),
      radial-gradient(40rem 30rem at 10% 90%, rgb(110 37 49 / 0.18), transparent 70%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.75rem;
    color: var(--brass);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .hero__word {
    display: inline-flex;
    gap: 0.6rem;
    white-space: nowrap;
  }

  .hero__dot {
    opacity: 0.6;
  }

  .hero__title {
    font-size: clamp(2.9rem, 6.4vw, 5rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.01em;
  }

  .hero__title em {
    display: block;
    color: var(--brass);
    font-style: italic;
  }

  .hero__lead {
    max-width: 34rem;
    margin-top: 2rem;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.75rem;
  }

  .hero__art {
    position: relative;
    justify-self: center;
    width: min(100%, 28rem);
    animation: rise 1.4s var(--ease) both 0.2s;
  }

  .hero__frame {
    position: absolute;
    inset: -1.25rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    pointer-events: none;
  }

  .accordion {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 2rem 3rem rgb(0 0 0 / 0.55));
  }

  .accordion__bellows {
    transform-box: fill-box;
    transform-origin: center;
    animation: breathe 6s ease-in-out infinite;
  }

  .hero__text > * {
    animation: rise 1.1s var(--ease) both;
  }

  .hero__text > :nth-child(2) {
    animation-delay: 0.08s;
  }

  .hero__text > :nth-child(3) {
    animation-delay: 0.16s;
  }

  .hero__text > :nth-child(4) {
    animation-delay: 0.24s;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.75rem;
    width: 1.5rem;
    height: 2.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 1rem;
    transform: translateX(-50%);
  }

  .hero__scroll span {
    position: absolute;
    left: 50%;
    top: 0.5rem;
    width: 2px;
    height: 0.45rem;
    margin-left: -1px;
    border-radius: 1px;
    background: var(--brass);
    animation: scroll-cue 2.2s ease-in-out infinite;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.75rem);
    }
  }

  @keyframes breathe {
    0%,
    100% {
      transform: scaleX(1);
    }
    50% {
      transform: scaleX(0.94);
    }
  }

  @keyframes scroll-cue {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    40% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(0.8rem);
    }
  }

  @media (max-width: 56rem) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__art {
      order: -1;
      width: min(70%, 18rem);
    }

    .hero__frame {
      inset: -0.75rem;
    }

    .hero__scroll {
      display: none;
    }
  }

  @media (max-width: 30rem) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
