---
import Icon from './Icon.astro';
import { config } from '../config';
import { dictionaries, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dictionaries[lang].lessons;
---

<section id="lessons" class="section section--raised" aria-labelledby="lessons-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="kicker"><span class="kicker__num">II</span>{t.kicker}</p>
      <h2 id="lessons-title" class="section-title">{t.title}</h2>
    </div>

    <ul class="features">
      {
        t.features.map((f, i) => (
          <li class="feature" data-reveal style={`transition-delay: ${i * 0.06}s`}>
            <span class="feature__icon">
              <Icon name={f.icon as 'music' | 'cap' | 'ornament' | 'people' | 'star'} />
            </span>
            <h3 class="feature__name">{f.name}</h3>
            <p class="feature__text">{f.text}</p>
          </li>
        ))
      }
      <li class="feature feature--quote" data-reveal style={`transition-delay: ${t.features.length * 0.06}s`}>
        <blockquote>
          <p>
            {t.quote[0]}
            <em>{t.quote[1]}</em>
          </p>
          <footer>— {config.teacherName[lang]}</footer>
        </blockquote>
      </li>
    </ul>
  </div>
</section>

<style>
  .features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .feature {
    padding: 2.25rem 2rem;
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.4s var(--ease);
  }

  .feature:hover {
    border-color: var(--line-strong);
  }

  .feature__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    margin-bottom: 1.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--brass);
  }

  .feature__icon :global(svg) {
    width: 1.35rem;
    height: 1.35rem;
  }

  .feature__name {
    font-size: 1.6rem;
    line-height: 1.15;
  }

  .feature__text {
    margin-top: 0.6rem;
    color: var(--muted);
    font-size: 0.98rem;
  }

  .feature--quote {
    display: flex;
    align-items: center;
    background:
      radial-gradient(circle at 30% 30%, rgb(201 164 106 / 0.14), transparent 70%),
      var(--bg-card);
    border-color: var(--line-strong);
  }

  .feature--quote blockquote {
    margin: 0;
  }

  .feature--quote p {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.2vw, 1.8rem);
    font-style: italic;
    line-height: 1.3;
  }

  .feature--quote em {
    display: block;
    color: var(--brass);
  }

  .feature--quote footer {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
  }

  @media (max-width: 60rem) {
    .features {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 38rem) {
    .features {
      grid-template-columns: 1fr;
    }

    .feature {
      padding: 1.75rem 1.5rem;
    }
  }
</style>
