---
import Icon from './Icon.astro';
import { dictionaries, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dictionaries[lang].lessons;
const numerals = ['01', '02', '03'];
---

<section id="lessons" class="section section--raised" aria-labelledby="lessons-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="kicker"><span class="kicker__num">II</span>{t.kicker}</p>
      <h2 id="lessons-title" class="section-title">{t.title}</h2>
      <p class="section-intro">{t.intro}</p>
    </div>

    <ol class="levels">
      {
        t.levels.map((level, i) => (
          <li class="level" data-reveal style={`transition-delay: ${i * 0.08}s`}>
            <span class="level__num">{numerals[i]}</span>
            <h3 class="level__name">{level.name}</h3>
            <p class="level__who">{level.who}</p>
            <ul class="level__points">
              {level.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <div class="formats" data-reveal>
      {
        t.formats.map((f, i) => (
          <div class="format">
            <Icon name={i === 0 ? 'pin' : 'video'} class="format__icon" />
            <div>
              <h3>{f.name}</h3>
              <p>{f.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .levels {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .level {
    position: relative;
    padding: 2.5rem 2rem 2.25rem;
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.4s var(--ease);
  }

  .level:hover {
    border-color: var(--line-strong);
  }

  .level::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 2rem;
    width: 3rem;
    height: 2px;
    background: var(--brass);
  }

  .level__num {
    display: block;
    margin-bottom: 1.5rem;
    color: var(--brass);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-style: italic;
  }

  .level__name {
    font-size: 2rem;
  }

  .level__who {
    margin-top: 0.6rem;
    min-height: 3.4em;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .level__points {
    display: grid;
    gap: 0.8rem;
    margin-top: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
  }

  .level__points li {
    position: relative;
    padding-left: 1.4rem;
  }

  .level__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.55rem;
    height: 1px;
    background: var(--brass);
  }

  .formats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .format {
    display: flex;
    gap: 1.25rem;
    padding: 1.75rem 2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .format :global(.format__icon) {
    flex-shrink: 0;
    width: 1.4rem;
    height: 1.4rem;
    margin-top: 0.3rem;
    color: var(--brass);
  }

  .format h3 {
    font-size: 1.5rem;
  }

  .format p {
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  @media (max-width: 60rem) {
    .levels {
      grid-template-columns: 1fr;
    }

    .level__who {
      min-height: 0;
    }
  }

  @media (max-width: 40rem) {
    .formats {
      grid-template-columns: 1fr;
    }

    .level,
    .format {
      padding-inline: 1.5rem;
    }
  }
</style>
