---
import Icon from './Icon.astro';
import { config } from '../config';
import { dictionaries, type Lang } from '../i18n';
import { links } from '../lib/contact';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dictionaries[lang].pricing;
const plans = (['trial', 'single', 'package', 'online'] as const).map((key) => ({
  key,
  ...t.plans[key],
  price: config.prices[key],
  featured: key === 'package',
}));
---

<section id="pricing" class="section" aria-labelledby="pricing-title">
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      <p class="kicker"><span class="kicker__num">III</span>{t.kicker}</p>
      <h2 id="pricing-title" class="section-title">{t.title}</h2>
      <p class="section-intro">{t.intro}</p>
    </div>

    <ul class="plans">
      {
        plans.map((plan, i) => (
          <li
            class:list={['plan', { 'plan--featured': plan.featured }]}
            data-reveal
            style={`transition-delay: ${i * 0.06}s`}
          >
            {plan.featured && <span class="plan__badge">{t.featured}</span>}
            <h3 class="plan__name">{plan.name}</h3>
            <p class="plan__duration">{plan.duration}</p>
            <p class="plan__price">{plan.price}</p>
            <p class="plan__note">{plan.note}</p>
          </li>
        ))
      }
    </ul>

    <div class="pricing__foot" data-reveal>
      <p>{t.footnote}</p>
      <a class="btn btn--ghost" href={links.whatsapp(lang)} target="_blank" rel="noopener">
        <Icon name="whatsapp" />
        {t.cta}
      </a>
    </div>
  </div>
</section>

<style>
  .plans {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2.25rem 1.75rem 2rem;
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-align: center;
  }

  .plan--featured {
    border-color: var(--brass);
    background:
      linear-gradient(180deg, rgb(201 164 106 / 0.1), transparent 55%),
      var(--bg-card);
  }

  .plan__badge {
    position: absolute;
    top: 0;
    left: 50%;
    padding: 0.3rem 0.85rem;
    background: var(--brass);
    border-radius: 999px;
    color: var(--bg);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: translate(-50%, -50%);
  }

  .plan__name {
    font-size: 1.6rem;
  }

  .plan__duration {
    margin-top: 0.4rem;
    color: var(--brass);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .plan__price {
    margin: 1.75rem 0 1.5rem;
    padding-block: 1.5rem;
    border-block: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.2vw, 2.4rem);
    line-height: 1;
    white-space: nowrap;
  }

  .plan__note {
    margin-top: auto;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .pricing__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.95rem;
  }

  @media (max-width: 64rem) {
    .plans {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 2rem;
    }
  }

  @media (max-width: 34rem) {
    .plans {
      grid-template-columns: 1fr;
    }
  }
</style>
